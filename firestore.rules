rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'krb.mullegama@gmail.com';
    }

    match /site/content {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn();
        allow update, delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.authorId);
      }

      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}